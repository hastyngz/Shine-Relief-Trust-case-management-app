rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // SHINE Relief Trust Secure Case Attachments
    // Strictly requires authenticated staff user.
    // Restricts file types to images and PDF documents under 15MB.
    match /attachments/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null &&
        request.resource.size < 15 * 1024 * 1024 &&
        (request.resource.contentType.matches('image/.*') || request.resource.contentType == 'application/pdf');
      allow delete: if request.auth != null;
    }
  }
}
