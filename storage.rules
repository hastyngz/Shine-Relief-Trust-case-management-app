rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function staffProfile() {
      return firestore.get(
        /databases/ai-studio-shinerelieftrust-3031a4c1-ab6c-4458-95a6-63205996e291/documents/staffUsers/$(request.auth.uid)
      );
    }

    function isActiveStaff() {
      return request.auth != null && (
        (request.auth.token.email != null &&
         request.auth.token.email.lower() == 'hastingszidanamot@gmail.com') ||
        (firestore.exists(
          /databases/ai-studio-shinerelieftrust-3031a4c1-ab6c-4458-95a6-63205996e291/documents/staffUsers/$(request.auth.uid)
        ) && staffProfile().data.status == 'Active')
      );
    }

    function canWriteAttachments() {
      return isActiveStaff() && (
        request.auth.token.email.lower() == 'hastingszidanamot@gmail.com' ||
        staffProfile().data.role in ['Administrator', 'Manager', 'Staff']
      );
    }

    function canViewHealthFiles() {
      return isActiveStaff() && (
        request.auth.token.email.lower() == 'hastingszidanamot@gmail.com' ||
        staffProfile().data.role in ['Administrator', 'Manager'] ||
        staffProfile().data.canViewHealthRecords == true
      );
    }

    function canEditHealthFiles() {
      return isActiveStaff() && (
        request.auth.token.email.lower() == 'hastingszidanamot@gmail.com' ||
        staffProfile().data.role in ['Administrator', 'Manager'] ||
        staffProfile().data.canEditHealthRecords == true
      );
    }

    function canReadSafeguardingFiles(caseId) {
      let caseRecord = firestore.get(
        /databases/ai-studio-shinerelieftrust-3031a4c1-ab6c-4458-95a6-63205996e291/documents/safeguardingCases/$(caseId)
      );
      return isActiveStaff() && (
        request.auth.token.email.lower() == 'hastingszidanamot@gmail.com' ||
        staffProfile().data.safeguardingPermissions.canView == true ||
        request.auth.uid in caseRecord.data.authorizedStaffUids
      );
    }

    function canWriteSafeguardingFiles(caseId) {
      let caseRecord = firestore.get(
        /databases/ai-studio-shinerelieftrust-3031a4c1-ab6c-4458-95a6-63205996e291/documents/safeguardingCases/$(caseId)
      );
      return isActiveStaff() && (
        request.auth.token.email.lower() == 'hastingszidanamot@gmail.com' ||
        staffProfile().data.safeguardingPermissions.canEdit == true ||
        request.auth.uid in caseRecord.data.authorizedStaffUids
      );
    }

    // SHINE Relief Trust Secure Case Attachments
    // Requires an active, rostered staff account.
    // Restricts file types to images and PDF documents under 15MB.
    match /attachments/{targetType}/{targetId}/{allPaths=**} {
      allow read: if targetType == 'safeguardingCase'
        ? canReadSafeguardingFiles(targetId)
        : targetType == 'healthFollowUp'
          ? canViewHealthFiles()
          : isActiveStaff();
      allow write: if (targetType == 'safeguardingCase'
        ? canWriteSafeguardingFiles(targetId)
        : targetType == 'healthFollowUp'
          ? canEditHealthFiles()
          : canWriteAttachments()) &&
        request.resource.size < 15 * 1024 * 1024 &&
        (request.resource.contentType.matches('image/.*') || request.resource.contentType == 'application/pdf');
      allow delete: if targetType == 'safeguardingCase'
        ? canWriteSafeguardingFiles(targetId)
        : targetType == 'healthFollowUp'
          ? canEditHealthFiles()
          : canWriteAttachments();
    }
  }
}
