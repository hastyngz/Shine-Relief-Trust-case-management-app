rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function staffProfile() {
      return firestore.get(
        /databases/(default)/documents/staffUsers/$(request.auth.uid)
      );
    }

    function isActiveStaff() {
      return request.auth != null && (
        (request.auth.token.email != null &&
         request.auth.token.email.lower() == 'hastingszidanamot@gmail.com') ||
        (firestore.exists(
          /databases/(default)/documents/staffUsers/$(request.auth.uid)
        ) && staffProfile().data.status == 'Active')
      );
    }

    function isAdmin() {
      return isActiveStaff() && (
        (request.auth.token.email != null &&
         request.auth.token.email.lower() == 'hastingszidanamot@gmail.com') ||
        staffProfile().data.role == 'Administrator'
      );
    }

    function canWriteAttachments() {
      return isActiveStaff() && (
        request.auth.token.email.lower() == 'hastingszidanamot@gmail.com' ||
        staffProfile().data.role in ['Administrator', 'Manager', 'Staff']
      );
    }

    function canViewHealthFiles() {
      return isActiveStaff() && (
        request.auth.token.email.lower() == 'hastingszidanamot@gmail.com' ||
        staffProfile().data.role in ['Administrator', 'Manager'] ||
        staffProfile().data.get('canViewHealthRecords', false) == true
      );
    }

    function canEditHealthFiles() {
      return isActiveStaff() && (
        request.auth.token.email.lower() == 'hastingszidanamot@gmail.com' ||
        staffProfile().data.role in ['Administrator', 'Manager'] ||
        staffProfile().data.get('canEditHealthRecords', false) == true
      );
    }

    function canReadSafeguardingFiles(caseId) {
      let caseRecord = firestore.get(
        /databases/(default)/documents/safeguardingCases/$(caseId)
      );
      return isActiveStaff() && (
        request.auth.token.email.lower() == 'hastingszidanamot@gmail.com' ||
        staffProfile().data.safeguardingPermissions.canView == true ||
        request.auth.uid in caseRecord.data.authorizedStaffUids
      );
    }

    function canWriteSafeguardingFiles(caseId) {
      let caseRecord = firestore.get(
        /databases/(default)/documents/safeguardingCases/$(caseId)
      );
      return isActiveStaff() && (
        request.auth.token.email.lower() == 'hastingszidanamot@gmail.com' ||
        staffProfile().data.safeguardingPermissions.canEdit == true ||
        request.auth.uid in caseRecord.data.authorizedStaffUids
      );
    }

    // SHINE Relief Trust Secure Case Attachments
    // Requires an active, rostered staff account.
    // Restricts file types to images and PDF documents under 15MB.
    match /attachments/{targetType}/{targetId}/{allPaths=**} {
      allow read: if targetType == 'safeguardingCase'
        ? canReadSafeguardingFiles(targetId)
        : (targetType == 'healthFollowUp' || resource.metadata.category in ['Medical Document', 'Prescription'])
          ? canViewHealthFiles()
          : isActiveStaff();
      allow write: if (targetType == 'safeguardingCase'
        ? canWriteSafeguardingFiles(targetId)
        : (targetType == 'healthFollowUp' || request.resource.metadata.category in ['Medical Document', 'Prescription'])
          ? canEditHealthFiles()
          : canWriteAttachments()) &&
        request.resource.size < 15 * 1024 * 1024 &&
        (request.resource.contentType.matches('image/.*') || request.resource.contentType == 'application/pdf');
      allow delete: if targetType == 'safeguardingCase'
        ? canWriteSafeguardingFiles(targetId)
        : (targetType == 'healthFollowUp' || resource.metadata.category in ['Medical Document', 'Prescription'])
          ? canEditHealthFiles()
          : canWriteAttachments();
    }

    match /reports/{ownerUid}/{reportId}/{fileName} {
      allow read: if isActiveStaff() && (
        request.auth.uid == ownerUid ||
        staffProfile().data.role in ['Administrator', 'Manager']
      );
      allow create: if canWriteAttachments() && request.auth.uid == ownerUid &&
        request.resource.size < 50 * 1024 * 1024 &&
        request.resource.contentType in [
          'application/pdf',
          'application/vnd.openxmlformats-officedocument.wordprocessingml.document',
          'application/vnd.openxmlformats-officedocument.spreadsheetml.sheet',
          'text/csv'
        ];
      allow update: if false;
      allow delete: if request.auth != null && request.auth.uid == ownerUid &&
        (isAdmin() || staffProfile().data.role == 'Manager');
    }

    match /audio/{ownerUid}/{recordType}/{recordId}/{fileName} {
      allow read: if isActiveStaff() && (request.auth.uid == ownerUid || staffProfile().data.role in ['Administrator', 'Manager']);
      allow write: if canWriteAttachments() && request.auth.uid == ownerUid &&
        request.resource.size < 25 * 1024 * 1024 &&
        request.resource.contentType in ['audio/mpeg', 'audio/wav', 'audio/x-wav', 'audio/mp4', 'audio/m4a', 'audio/webm'];
      allow delete: if request.auth != null && request.auth.uid == ownerUid;
    }
  }
}
