# SHINE privacy policy: external AI providers are disabled in the server code.
# Do not configure third-party AI for beneficiary, household, health, safeguarding,
# staff or financial data. Re-enable only after a private processing route is
# approved, implemented and tested.
GEMINI_API_KEY=""
OPENROUTER_API_KEY=""
OPENROUTER_MODELS=""

# Set to the deployed R2 Worker origin to use Cloudflare for file storage in production.
# Leave empty for local Express development at the same origin.
VITE_R2_API_URL="https://shine-relief-r2-storage-api.shine-relief-trust-cms.workers.dev"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Cloudflare R2 object storage. Keep these credentials server-side only.
CLOUDFLARE_API_TOKEN=""
CLOUDFLARE_R2_ACCESS_KEY_ID=""
CLOUDFLARE_R2_SECRET_ACCESS_KEY=""
CLOUDFLARE_R2_ENDPOINT="https://9a7cfcaf1c569951cca8c99d872dec88.r2.cloudflarestorage.com"
CLOUDFLARE_R2_BUCKET_NAME="shine-relief-trust-cms-storage"
# Informational only; private attachments are served using short-lived signed URLs.
CLOUDFLARE_R2_PUBLIC_URL="https://pub-4acd007edaf14f118db5c46a969d628d.r2.dev"

# Server rate limits (per authenticated user, per minute). Optional; defaults below.
# SHINE_AI_RATE_LIMIT="20"
# SHINE_STORAGE_RATE_LIMIT="60"
# SHINE_SAFEGUARDING_RATE_LIMIT="60"
