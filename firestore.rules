rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    // The primary Administrator email must be verified even if a legacy profile
    // already exists under that UID. Other pre-registered staff remain UID-bound.
    function isPrimaryEmailVerified() {
      return isSignedIn() && (
        request.auth.token.get('email', null) == null ||
        request.auth.token.get('email', '').lower() != 'hastingszidanamot@gmail.com' ||
        request.auth.token.get('email_verified', false) == true
      );
    }

    function isHastings() {
      return isSignedIn() &&
        request.auth.token.get('email', null) != null &&
        request.auth.token.get('email', '').lower() == 'hastingszidanamot@gmail.com' &&
        request.auth.token.get('email_verified', false) == true;
    }

    function getStaffDoc(uid) {
      return get(/databases/$(database)/documents/staffUsers/$(uid));
    }

    function isStaffActive() {
      return isSignedIn() && isPrimaryEmailVerified() && (
        isHastings() ||
        (exists(/databases/$(database)/documents/staffUsers/$(request.auth.uid)) &&
         getStaffDoc(request.auth.uid).data.status == 'Active')
      );
    }

    function isAdmin() {
      return isSignedIn() && isPrimaryEmailVerified() && (
        isHastings() ||
        (exists(/databases/$(database)/documents/staffUsers/$(request.auth.uid)) &&
         getStaffDoc(request.auth.uid).data.role == 'Administrator' &&
         getStaffDoc(request.auth.uid).data.status == 'Active')
      );
    }

    function isManagerOrStaff() {
      return isSignedIn() && isPrimaryEmailVerified() && (
        isAdmin() ||
        (exists(/databases/$(database)/documents/staffUsers/$(request.auth.uid)) &&
         (getStaffDoc(request.auth.uid).data.role == 'Manager' || getStaffDoc(request.auth.uid).data.role == 'Staff') &&
         getStaffDoc(request.auth.uid).data.status == 'Active')
      );
    }

    function isManagerOrAdmin() {
      return isAdmin() || (
        isSignedIn() && isPrimaryEmailVerified() &&
        exists(/databases/$(database)/documents/staffUsers/$(request.auth.uid)) &&
        getStaffDoc(request.auth.uid).data.role == 'Manager' &&
        getStaffDoc(request.auth.uid).data.status == 'Active'
      );
    }

    function canViewHealthRecords() {
      return isManagerOrAdmin() || (
        isStaffActive() &&
        getStaffDoc(request.auth.uid).data.canViewHealthRecords == true
      );
    }

    function canViewSafeguardingRecords() {
      return isAdmin() || (
        isStaffActive() &&
        getStaffDoc(request.auth.uid).data.get('safeguardingPermissions', {}).get('canView', false) == true
      );
    }

    function canViewCaseReviews() {
      return isManagerOrAdmin() || (
        isStaffActive() &&
        getStaffDoc(request.auth.uid).data.canViewCaseReviews == true
      );
    }

    function canEditCaseReviews() {
      return isManagerOrAdmin() || (
        isManagerOrStaff() &&
        getStaffDoc(request.auth.uid).data.canEditCaseReviews == true
      );
    }

    function canEditHealthRecords() {
      return isManagerOrAdmin() || (
        isManagerOrStaff() &&
        getStaffDoc(request.auth.uid).data.canEditHealthRecords == true
      );
    }

    // Inventory transactions touch several documents in one atomic batch. Use
    // compact, equivalent role predicates here to avoid repeating the broader
    // application RBAC expression for every document in that batch.
    function isInventoryActiveStaff() {
      return isSignedIn() && isPrimaryEmailVerified() && (
        isHastings() ||
        getStaffDoc(request.auth.uid).data.get('status', '') == 'Active'
      );
    }

    function isInventoryWriter() {
      return isSignedIn() && isPrimaryEmailVerified() && (
        isHastings() ||
        (
          getStaffDoc(request.auth.uid).data.get('status', '') == 'Active' &&
          getStaffDoc(request.auth.uid).data.get('role', '') in ['Administrator', 'Manager', 'Staff']
        )
      );
    }

    function isInventoryQuantityPrecisionValid(unit, quantity) {
      let normalizedUnit = unit.lower();
      return quantity is number && quantity >= 0 && (
        (normalizedUnit in ['kg', 'kilogram', 'kilograms', 'litre', 'litres', 'liter', 'liters', 'l'] &&
          quantity * 100 - int(quantity * 100) < 0.000001) ||
        (normalizedUnit in ['bag', 'bags', 'piece', 'pieces', 'bottle', 'bottles', 'box', 'boxes', 'pack', 'packs', 'tray', 'trays', 'unit', 'units'] &&
          quantity == int(quantity))
      );
    }

    function inventoryManagedBalanceMatches(itemId, itemAfter, movementId, actorUid) {
      let locationId = itemAfter.locationId;
      let balanceId = 'bal_' + string(itemId.size()) + '_' + itemId + '_' + locationId;
      let balancePath = /databases/$(database)/documents/inventoryLocationBalances/$(balanceId);
      let balance = getAfter(balancePath).data;
      return !itemAfter.keys().hasAny(['locationId']) || (
        locationId is string &&
        existsAfter(balancePath) &&
        balance.id == balanceId &&
        balance.inventoryItemId == itemId &&
        balance.locationId == locationId &&
        balance.unit == itemAfter.unit &&
        balance.quantity == itemAfter.quantityOnHand &&
        balance.lastMovementId == movementId &&
        balance.updatedByUid == actorUid
      );
    }

    function inventoryMovementMatchesItem(itemId, movementId) {
      let movementPath = /databases/$(database)/documents/inventoryMovements/$(movementId);
      let itemPath = /databases/$(database)/documents/inventoryItems/$(itemId);
      let itemAfter = getAfter(itemPath).data;
      let movement = getAfter(movementPath).data;
      let embedded = request.resource.data.movements[request.resource.data.movements.size() - 1];
      return existsAfter(movementPath) &&
        inventoryManagedBalanceMatches(itemId, itemAfter, movementId, request.auth.uid) &&
        movement.inventoryItemId == itemId &&
        movement.id == movementId &&
        movement.recordedByUid == request.auth.uid &&
        (!resource.data.keys().hasAny(['locationId']) ||
          (movement.locationId == resource.data.locationId && embedded.locationId == resource.data.locationId)) &&
        movement.previousQuantity == resource.data.quantityOnHand &&
        movement.newQuantity == request.resource.data.quantityOnHand &&
        embedded.type == movement.type &&
        embedded.quantity == movement.quantity &&
        embedded.date == movement.date &&
        embedded.reason == movement.reason &&
        embedded.createdAt == movement.createdAt &&
        movement.quantity is number &&
        movement.quantity >= 0 &&
        isInventoryQuantityPrecisionValid(resource.data.unit, movement.previousQuantity) &&
        isInventoryQuantityPrecisionValid(resource.data.unit, movement.newQuantity) &&
        isInventoryQuantityPrecisionValid(resource.data.unit, movement.quantity) &&
        (
          (movement.type == 'Received' &&
            movement.quantity > 0 &&
            movement.newQuantity == movement.previousQuantity + movement.quantity) ||
          (movement.type == 'Issued' &&
            movement.quantity > 0 &&
            movement.quantity <= movement.previousQuantity &&
            movement.newQuantity == movement.previousQuantity - movement.quantity) ||
          (movement.type == 'Adjustment' &&
            movement.newQuantity >= 0 &&
            movement.quantity == (movement.newQuantity >= movement.previousQuantity
              ? movement.newQuantity - movement.previousQuantity
              : movement.previousQuantity - movement.newQuantity))
        );
    }

    function isValidInventoryMovementUpdate(itemId) {
      let movementId = request.resource.data.lastMovementId;
      return movementId is string &&
        request.resource.data.quantityOnHand is number &&
        request.resource.data.quantityOnHand >= 0 &&
        request.resource.data.movements is list &&
        request.resource.data.movements.size() == resource.data.get('movements', []).size() + 1 &&
        request.resource.data.movements.hasAll(resource.data.get('movements', [])) &&
        request.resource.data.movements[request.resource.data.movements.size() - 1].id == movementId &&
        inventoryMovementMatchesItem(itemId, movementId);
    }

    function inventoryBalanceMovementMatches(balanceId, itemId, locationId, movementId) {
      let itemPath = /databases/$(database)/documents/inventoryItems/$(itemId);
      let movementPath = /databases/$(database)/documents/inventoryMovements/$(movementId);
      let locationPath = /databases/$(database)/documents/inventoryLocations/$(locationId);
      let itemAfter = getAfter(itemPath).data;
      let movement = getAfter(movementPath).data;
      return isInventoryActiveStaff() &&
        itemId is string && locationId is string && movementId is string &&
        balanceId == 'bal_' + string(itemId.size()) + '_' + itemId + '_' + locationId &&
        existsAfter(itemPath) && existsAfter(movementPath) && exists(locationPath) &&
        get(locationPath).data.isActive == true &&
        itemAfter.locationId == locationId &&
        itemAfter.unit == request.resource.data.unit &&
        itemAfter.lastMovementId == movementId &&
        itemAfter.quantityOnHand == request.resource.data.quantity &&
        itemAfter.movements is list && itemAfter.movements.size() > 0 &&
        itemAfter.movements[itemAfter.movements.size() - 1].id == movementId &&
        movement.id == movementId &&
        movement.inventoryItemId == itemId &&
        movement.locationId == locationId &&
        movement.recordedByUid == request.auth.uid &&
        movement.newQuantity == request.resource.data.quantity &&
        movement.newQuantity is number &&
        movement.previousQuantity is number &&
        movement.quantity is number &&
        movement.unit == request.resource.data.unit;
    }

    function isValidInventoryLocationBalanceCreate(balanceId) {
      let itemId = request.resource.data.inventoryItemId;
      let itemPath = /databases/$(database)/documents/inventoryItems/$(itemId);
      let movementId = request.resource.data.lastMovementId;
      let movementPath = /databases/$(database)/documents/inventoryMovements/$(movementId);
      return inventoryBalanceMovementMatches(balanceId, itemId, request.resource.data.locationId, movementId) &&
        request.resource.data.id == balanceId &&
        request.resource.data.unit is string &&
        request.resource.data.quantity is number &&
        request.resource.data.quantity >= 0 &&
        isInventoryQuantityPrecisionValid(request.resource.data.unit, request.resource.data.quantity) &&
        request.resource.data.createdByUid == request.auth.uid &&
        request.resource.data.updatedByUid == request.auth.uid &&
        request.resource.data.createdAt == getAfter(movementPath).data.createdAt &&
        request.resource.data.updatedAt == getAfter(movementPath).data.createdAt &&
        get(itemPath).data.quantityOnHand == 0 &&
        !get(itemPath).data.keys().hasAny(['lastMovementId']) &&
        get(itemPath).data.get('movements', []).size() == 0 &&
        getAfter(movementPath).data.type == 'Received' &&
        getAfter(movementPath).data.quantity > 0 &&
        getAfter(movementPath).data.previousQuantity == 0;
    }

    function isValidInventoryLocationBalanceUpdate(balanceId) {
      let itemId = request.resource.data.inventoryItemId;
      let movementId = request.resource.data.lastMovementId;
      let movementPath = /databases/$(database)/documents/inventoryMovements/$(movementId);
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      return inventoryBalanceMovementMatches(balanceId, itemId, request.resource.data.locationId, movementId) &&
        request.resource.data.id == resource.data.id &&
        request.resource.data.inventoryItemId == resource.data.inventoryItemId &&
        request.resource.data.locationId == resource.data.locationId &&
        request.resource.data.unit == resource.data.unit &&
        request.resource.data.quantity is number &&
        request.resource.data.quantity >= 0 &&
        isInventoryQuantityPrecisionValid(resource.data.unit, request.resource.data.quantity) &&
        resource.data.quantity == getAfter(movementPath).data.previousQuantity &&
        resource.data.lastMovementId is string && resource.data.lastMovementId.size() > 0 &&
        resource.data.lastMovementId == get(/databases/$(database)/documents/inventoryItems/$(itemId)).data.lastMovementId &&
        changed.hasOnly(['quantity', 'updatedAt', 'updatedByUid', 'lastMovementId']) &&
        request.resource.data.updatedByUid == request.auth.uid &&
        request.resource.data.updatedAt == getAfter(movementPath).data.createdAt;
    }

    function procurementOutstandingQuantity(procurementPath, lineIndex) {
      let procurement = get(procurementPath).data;
      let receivedMap = procurement.get('receivedQuantitiesByLine', {});
      let legacyReceived = procurement.get('receivedQuantities', []);
      let ledgerReceived = receivedMap.get('line_' + string(lineIndex), receivedMap.get(string(lineIndex), 0));
      let oldReceived = legacyReceived.size() > lineIndex ? legacyReceived[lineIndex] : 0;
      let alreadyReceived = ledgerReceived > oldReceived ? ledgerReceived : oldReceived;
      return procurement.items[lineIndex].quantity - alreadyReceived;
    }

    function procurementReceiptMovementMatches(id, movementId) {
      let movementPath = /databases/$(database)/documents/inventoryMovements/$(movementId);
      let movement = getAfter(movementPath).data;
      let itemPath = /databases/$(database)/documents/inventoryItems/$(movement.inventoryItemId);
      let itemAfter = getAfter(itemPath).data;
      return existsAfter(movementPath) &&
        existsAfter(itemPath) &&
        inventoryManagedBalanceMatches(movement.inventoryItemId, itemAfter, movementId, request.auth.uid) &&
        movement.id == movementId &&
        movement.sourceType == 'procurementReceipt' &&
        movement.sourceId == id &&
        movement.sourceLineIndex is int &&
        movement.sourceLineIndex >= 0 &&
        movement.recordedByUid == request.auth.uid;
    }

    function procurementReceiptLedgerDeltaMatches(lineIndex, movementQuantity) {
      let oldMap = resource.data.get('receivedQuantitiesByLine', {});
      let oldArray = resource.data.get('receivedQuantities', []);
      let newMap = request.resource.data.get('receivedQuantitiesByLine', {});
      let oldLedger = oldMap.get('line_' + string(lineIndex), oldMap.get(string(lineIndex), 0));
      let oldLegacy = oldArray.size() > lineIndex ? oldArray[lineIndex] : 0;
      let prior = oldLedger > oldLegacy ? oldLedger : oldLegacy;
      let newValue = newMap.get('line_' + string(lineIndex), newMap.get(string(lineIndex), 0));
      return newMap.diff(oldMap).affectedKeys().hasOnly(['line_' + string(lineIndex), string(lineIndex)]) &&
        newValue == prior + movementQuantity &&
        request.resource.data.items is list &&
        request.resource.data.items.size() > lineIndex &&
        newValue <= request.resource.data.items[lineIndex].quantity;
    }

    function isValidProcurementReceiptLedgerUpdate(id) {
      let movementId = request.resource.data.get('lastReceiptMovementId', '');
      let movementPath = /databases/$(database)/documents/inventoryMovements/$(movementId);
      let movement = getAfter(movementPath).data;
      let lineIndex = movement.sourceLineIndex;
      return resource.data.id == id &&
        resource.data.status == 'purchased' &&
        request.resource.data.status == resource.data.status &&
        request.resource.data.diff(resource.data).affectedKeys().hasAll(['receivedQuantitiesByLine', 'lastReceiptMovementId']) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['receivedQuantitiesByLine', 'lastReceiptMovementId', 'updatedAt', 'updatedBy']) &&
        movementId is string && movementId.size() > 0 &&
        procurementReceiptMovementMatches(id, movementId) &&
        procurementReceiptLedgerDeltaMatches(lineIndex, movement.quantity);
    }
    function isValidProcurementReceiptSource(itemId) {
      let procurementPath = /databases/$(database)/documents/procurementLists/$(request.resource.data.sourceId);
      let itemPath = /databases/$(database)/documents/inventoryItems/$(itemId);
      let locationPath = /databases/$(database)/documents/inventoryLocations/$(request.resource.data.locationId);
      let lineIndex = request.resource.data.sourceLineIndex;
      return request.resource.data.sourceType == 'procurementReceipt' &&
        request.resource.data.type == 'Received' &&
        request.resource.data.sourceId is string &&
        request.resource.data.sourceId.matches('^[A-Za-z0-9_-]{1,100}$') &&
        request.resource.data.sourceLineIndex is int &&
        lineIndex >= 0 && lineIndex <= 9999 &&
        request.resource.data.reference is string &&
        request.resource.data.reference.size() > 0 &&
        request.resource.data.reference.size() <= 250 &&
        exists(itemPath) &&
        get(itemPath).data.locationId is string &&
        request.resource.data.locationId == get(itemPath).data.locationId &&
        exists(locationPath) && get(locationPath).data.isActive == true &&
        exists(procurementPath) &&
        get(procurementPath).data.id == request.resource.data.sourceId &&
        get(procurementPath).data.status == 'purchased' &&
        !get(procurementPath).data.keys().hasAny(['receivedAt']) &&
        get(procurementPath).data.items is list &&
        get(procurementPath).data.items.size() > lineIndex &&
        request.resource.data.quantity is number &&
        request.resource.data.quantity > 0 &&
        procurementOutstandingQuantity(procurementPath, lineIndex) > 0 &&
        request.resource.data.quantity <= procurementOutstandingQuantity(procurementPath, lineIndex) &&
        ((request.resource.data.keys().hasAny(['sourceDeliveryId']) &&
          request.resource.data.sourceDeliveryId is string &&
          request.resource.data.sourceDeliveryId.matches('^delivery_[A-Za-z0-9_-]{8,100}$')) ||
         (!request.resource.data.keys().hasAny(['sourceDeliveryId']) &&
          request.resource.data.quantity == procurementOutstandingQuantity(procurementPath, lineIndex))) &&
        get(procurementPath).data.items[lineIndex].unit is string &&
        get(procurementPath).data.items[lineIndex].unit.size() > 0 &&
        get(itemPath).data.unit is string &&
        get(procurementPath).data.items[lineIndex].unit == get(itemPath).data.unit;
    }
    function isValidInventoryMovementCreate(movementId) {
      let itemId = request.resource.data.inventoryItemId;
      let itemPath = /databases/$(database)/documents/inventoryItems/$(itemId);
      let itemAfter = getAfter(itemPath).data;
      return isInventoryWriter() &&
        request.resource.data.id == movementId &&
        request.resource.data.recordedByUid == request.auth.uid &&
        request.resource.data.previousQuantity is number &&
        request.resource.data.newQuantity is number &&
        request.resource.data.quantity is number &&
        request.resource.data.quantity >= 0 &&
        (!request.resource.data.keys().hasAny(['sourceType']) || isValidProcurementReceiptSource(itemId)) &&
        exists(itemPath) &&
        (!get(itemPath).data.keys().hasAny(['locationId']) ||
          (request.resource.data.locationId == get(itemPath).data.locationId &&
           exists(/databases/$(database)/documents/inventoryLocations/$(request.resource.data.locationId)) &&
           get(/databases/$(database)/documents/inventoryLocations/$(request.resource.data.locationId)).data.isActive == true)) &&
        isInventoryQuantityPrecisionValid(get(itemPath).data.unit, request.resource.data.previousQuantity) &&
        isInventoryQuantityPrecisionValid(get(itemPath).data.unit, request.resource.data.newQuantity) &&
        isInventoryQuantityPrecisionValid(get(itemPath).data.unit, request.resource.data.quantity) &&
        existsAfter(itemPath) &&
        itemAfter.lastMovementId == movementId &&
        itemAfter.quantityOnHand == request.resource.data.newQuantity &&
        inventoryManagedBalanceMatches(itemId, itemAfter, movementId, request.auth.uid) &&
        get(itemPath).data.quantityOnHand == request.resource.data.previousQuantity &&
        (
          (request.resource.data.type == 'Received' &&
            request.resource.data.quantity > 0 &&
            request.resource.data.newQuantity == request.resource.data.previousQuantity + request.resource.data.quantity) ||
          (request.resource.data.type == 'Issued' &&
            request.resource.data.quantity > 0 &&
            request.resource.data.quantity <= request.resource.data.previousQuantity &&
            request.resource.data.newQuantity == request.resource.data.previousQuantity - request.resource.data.quantity) ||
          (request.resource.data.type == 'Adjustment' &&
            request.resource.data.newQuantity >= 0 &&
            request.resource.data.quantity == (request.resource.data.newQuantity >= request.resource.data.previousQuantity
              ? request.resource.data.newQuantity - request.resource.data.previousQuantity
              : request.resource.data.previousQuantity - request.resource.data.newQuantity))
        );
    }

    function importAuditMigrationComplete() {
      return exists(/databases/$(database)/documents/importAuditMigrationStatus/sourceDataBoundary) &&
        get(/databases/$(database)/documents/importAuditMigrationStatus/sourceDataBoundary).data.status == 'complete';
    }

    function hasMatchingRestrictedImportSource(auditId, auditData) {
      let sourcePath = /databases/$(database)/documents/restrictedImportSources/$(auditId);
      return existsAfter(sourcePath) &&
        getAfter(sourcePath).data.id == auditId &&
        getAfter(sourcePath).data.auditId == auditId &&
        getAfter(sourcePath).data.fileName == auditData.get('fileName', '') &&
        getAfter(sourcePath).data.importedAt == auditData.get('importedAt', '') &&
        getAfter(sourcePath).data.keys().hasAll(['sourceData']) &&
        getAfter(sourcePath).data.sourceData is map &&
        getAfter(sourcePath).data.sourceData.keys().size() > 0;
    }

    function canReadSafeguarding(caseId) {
      let caseRecord = get(/databases/$(database)/documents/safeguardingCases/$(caseId));
      return isAdmin() || (
        isStaffActive() && (
          getStaffDoc(request.auth.uid).data.safeguardingPermissions.canView == true ||
          request.auth.uid in caseRecord.data.authorizedStaffUids
        )
      );
    }

    function canWriteSafeguardingAttachment(caseId) {
      let caseRecord = get(/databases/$(database)/documents/safeguardingCases/$(caseId));
      return isAdmin() || (
        isStaffActive() && (
          getStaffDoc(request.auth.uid).data.safeguardingPermissions.canEdit == true ||
          request.auth.uid in caseRecord.data.authorizedStaffUids
        )
      );
    }

    // Staff Users Management collection
    match /staffUsers/{userId} {
      // Active staff can view the roster; a verified, unregistered email can read only its matching pre-registered profile for UID linking.
      allow read: if isAdmin() || isStaffActive() || (
        isSignedIn() &&
        request.auth.token.get('email_verified', false) == true &&
        request.auth.token.get('email', null) != null &&
        request.auth.token.get('email', '').lower() == resource.data.email.lower()
      );

      // Bootstrap rule: Hastings can initialize his own Administrator doc.
      // All other staff creations MUST be performed by an existing Administrator.
      // Self-registration as Administrator by anyone else is strictly blocked.
      allow create: if isSignedIn() && (
        (isHastings() && request.auth.uid == userId && request.resource.data.role == 'Administrator' && request.resource.data.email is string && request.resource.data.email.lower() == request.auth.token.get('email', '').lower()) ||
        isAdmin()
      );

      // Only Administrators can modify roles or toggle active/suspended statuses.
      // Non-admin staff can only update their own basic profile fields (phone, etc.)
      // and CANNOT modify role, status, or promote themselves.
      allow update: if isSignedIn() && (
        isAdmin() ||
        (isManagerOrAdmin() && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'employeeCategory', 'position', 'contractStartDate', 'contractEndDate',
          'contractType', 'contractDuration', 'contractStatus', 'renewalInformation',
          'employmentStatus', 'originalContractStartDate', 'employmentPeriods', 'updatedAt'
        ])) ||
        (request.auth.uid == userId &&
         request.resource.data.role == resource.data.role &&
         request.resource.data.status == resource.data.status &&
         request.resource.data.diff(resource.data).affectedKeys().hasOnly([
           'phone', 'departmentOrTitle', 'updatedAt', 'lastLoginAt'
         ]))
      );

      // Only Administrators can delete a staff user, and Hastings' primary account cannot be deleted.
      allow delete: if isAdmin() &&
        resource.data.email != null &&
        resource.data.email.lower() != 'hastingszidanamot@gmail.com';
    }

    // SHINE Operational Collections
    // Enforces RBAC permissions:
    // - Active Staff / Managers / Administrators / View Only can READ.
    // - View Only users CANNOT modify data (create, update, delete are blocked).
    // - Manager and Staff can create and update operational records.
    // - Deletion of high-impact entities (girls, households, rent) requires Administrator.

    match /girls/{girlId} {
      allow read: if isStaffActive();
      allow create, update: if isManagerOrStaff();
      allow delete: if isAdmin();
    }

    match /households/{houseId} {
      allow read: if isStaffActive();
      allow create, update: if isManagerOrStaff();
      allow delete: if isAdmin();
    }

    match /educationalFollowUps/{id} {
      allow read: if isStaffActive();
      allow create, update: if isManagerOrStaff();
      allow delete: if isManagerOrStaff();
    }

    match /healthFollowUps/{id} {
      allow read: if canViewHealthRecords();
      allow create, update: if canEditHealthRecords();
      allow delete: if isAdmin() || (isManagerOrStaff() && getStaffDoc(request.auth.uid).data.canEditHealthRecords == true);
    }

    match /familyFollowUps/{id} {
      allow read: if isStaffActive();
      allow create, update: if isManagerOrStaff();
      allow delete: if isManagerOrStaff();
    }

    match /rentPayments/{id} {
      allow read: if isStaffActive();
      allow create, update: if isManagerOrStaff();
      allow delete: if isAdmin();
    }

    // Ordinary staff may record/edit operational expense details, but payment settlement
    // fields and payment-status audit events are reserved for Managers/Administrators.
    function expenseCreatePaymentFieldsAllowed() {
      return request.resource.data.get('paymentStatus', 'Payment Outstanding') == 'Payment Outstanding' &&
        request.resource.data.get('datePaid', null) == null &&
        request.resource.data.get('paymentMethod', null) == null &&
        request.resource.data.get('paymentReference', null) == null;
    }

    function expensePaymentFieldsUnchanged() {
      let before = resource.data;
      let after = request.resource.data;
      return after.get('paymentStatus', null) == before.get('paymentStatus', null) &&
        after.get('amountDue', null) == before.get('amountDue', null) &&
        after.get('datePaid', null) == before.get('datePaid', null) &&
        after.get('paymentMethod', null) == before.get('paymentMethod', null) &&
        after.get('paymentReference', null) == before.get('paymentReference', null);
    }

    function expenseAuditTrailSafeForStaffUpdate() {
      let before = resource.data.get('auditTrail', []);
      let after = request.resource.data.get('auditTrail', []);
      return after == before ||
        (before is list && after is list &&
          after.size() == before.size() + 1 &&
          after.hasAll(before) &&
          after[after.size() - 1].get('action', '') == 'updated' &&
          !after[after.size() - 1].keys().hasAny(['previousStatus', 'newStatus']));
    }

    match /expenses/{id} {
      allow read: if isStaffActive();
      allow create: if isManagerOrAdmin() || (isManagerOrStaff() && expenseCreatePaymentFieldsAllowed());
      allow update: if isManagerOrAdmin() ||
        (isManagerOrStaff() && expensePaymentFieldsUnchanged() && expenseAuditTrailSafeForStaffUpdate());
      allow delete: if isManagerOrStaff();
    }

    function pettyCashLedgerStatePath() {
      return /databases/$(database)/documents/pettyCashLedgerState/current;
    }

    function pettyCashActorNameMatchesAuth() {
      let staffPath = /databases/$(database)/documents/staffUsers/$(request.auth.uid);
      let tokenName = request.auth.token.get('name', '');
      let tokenEmail = request.auth.token.get('email', '');
      return (
          exists(staffPath) &&
          request.resource.data.recordedBy == getStaffDoc(request.auth.uid).data.fullName
        ) ||
        (
          !exists(staffPath) &&
          isHastings() &&
          request.resource.data.recordedBy ==
            (tokenName is string && tokenName.size() > 0 ? tokenName : tokenEmail)
        );
    }

    function isValidPettyCashLedgerState() {
      return request.resource.data.keys().hasOnly([
          'balanceMWK', 'latestDate', 'lastTransactionId', 'updatedAt'
        ]) &&
        request.resource.data.balanceMWK is int &&
        request.resource.data.balanceMWK >= 0 &&
        request.resource.data.latestDate is string &&
        request.resource.data.latestDate.size() == 10 &&
        request.resource.data.lastTransactionId is string &&
        request.resource.data.lastTransactionId.size() > 0 &&
        request.resource.data.updatedAt is string;
    }

    function pettyCashStateMatchesNewEntry(entryId) {
      let entryPath = /databases/$(database)/documents/pettyCashTransactions/$(entryId);
      let entry = getAfter(entryPath).data;
      return !exists(entryPath) &&
        existsAfter(entryPath) &&
        entry.id == entryId &&
        request.resource.data.lastTransactionId == entryId &&
        request.resource.data.latestDate == entry.date &&
        request.resource.data.updatedAt == entry.recordedAt;
    }

    function pettyCashEntryMatchesState(id) {
      let state = getAfter(pettyCashLedgerStatePath()).data;
      let currentState = get(pettyCashLedgerStatePath()).data;
      return existsAfter(pettyCashLedgerStatePath()) &&
        state.lastTransactionId == id &&
        state.latestDate == request.resource.data.date &&
        state.updatedAt == request.resource.data.recordedAt &&
        (
          (!exists(pettyCashLedgerStatePath()) &&
            request.resource.data.type == 'opening_balance' &&
            state.balanceMWK == request.resource.data.amountMWK) ||
          (exists(pettyCashLedgerStatePath()) &&
            request.resource.data.type in ['cash_received', 'cash_returned', 'adjustment_in'] &&
            request.resource.data.date >= currentState.latestDate &&
            state.balanceMWK == currentState.balanceMWK + request.resource.data.amountMWK) ||
          (exists(pettyCashLedgerStatePath()) &&
            request.resource.data.type in ['expense', 'adjustment_out'] &&
            request.resource.data.date >= currentState.latestDate &&
            request.resource.data.amountMWK <= currentState.balanceMWK &&
            state.balanceMWK == currentState.balanceMWK - request.resource.data.amountMWK)
        );
    }

    // Petty cash is an append-only, Manager/Administrator-only ledger. Every
    // movement and its balance checkpoint must be written atomically.
    match /pettyCashLedgerState/{id} {
      allow read: if isManagerOrAdmin() && id == 'current';
      allow create: if isManagerOrAdmin() &&
        id == 'current' &&
        isValidPettyCashLedgerState() &&
        pettyCashStateMatchesNewEntry(request.resource.data.lastTransactionId) &&
        request.resource.data.lastTransactionId == 'PETTY_CASH_OPENING_BALANCE';
      allow update: if isManagerOrAdmin() &&
        id == 'current' &&
        isValidPettyCashLedgerState() &&
        pettyCashStateMatchesNewEntry(request.resource.data.lastTransactionId) &&
        request.resource.data.lastTransactionId != 'PETTY_CASH_OPENING_BALANCE' &&
        (
          request.resource.data.balanceMWK == resource.data.balanceMWK + getAfter(
            /databases/$(database)/documents/pettyCashTransactions/$(request.resource.data.lastTransactionId)
          ).data.amountMWK ||
          request.resource.data.balanceMWK == resource.data.balanceMWK - getAfter(
            /databases/$(database)/documents/pettyCashTransactions/$(request.resource.data.lastTransactionId)
          ).data.amountMWK
        );
      allow delete: if false;
    }

    match /pettyCashTransactions/{id} {
      allow read: if isManagerOrAdmin();
      allow create: if isManagerOrAdmin() &&
        request.resource.data.id == id &&
        request.resource.data.keys().hasOnly([
          'id', 'date', 'type', 'amountMWK', 'description', 'reference',
          'category', 'recordedAt', 'recordedBy', 'recordedByUid', 'createdAt'
        ]) &&
        request.resource.data.date is string &&
        request.resource.data.date.size() == 10 &&
        request.resource.data.date.matches('^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])$') &&
        request.resource.data.amountMWK is int && request.resource.data.amountMWK > 0 &&
        request.resource.data.description is string &&
        request.resource.data.description.size() >= 3 && request.resource.data.description.size() <= 250 &&
        request.resource.data.reference is string &&
        request.resource.data.reference.size() >= 2 && request.resource.data.reference.size() <= 120 &&
        request.resource.data.recordedAt is string && request.resource.data.createdAt is string &&
        request.resource.data.recordedBy is string && request.resource.data.recordedBy.size() > 0 &&
        request.resource.data.recordedByUid is string && request.resource.data.recordedByUid.size() > 0 &&
        request.resource.data.recordedByUid == request.auth.uid &&
        pettyCashActorNameMatchesAuth() &&
        (!request.resource.data.keys().hasAny(['category']) ||
          (request.resource.data.category is string && request.resource.data.category.size() <= 100)) &&
        (
          (request.resource.data.type == 'opening_balance' &&
            id == 'PETTY_CASH_OPENING_BALANCE' &&
            !exists(/databases/$(database)/documents/pettyCashTransactions/PETTY_CASH_OPENING_BALANCE)) ||
          (request.resource.data.type in ['cash_received', 'expense', 'cash_returned', 'adjustment_in', 'adjustment_out'] &&
            id != 'PETTY_CASH_OPENING_BALANCE' &&
            existsAfter(/databases/$(database)/documents/pettyCashTransactions/PETTY_CASH_OPENING_BALANCE))
        ) &&
        pettyCashEntryMatchesState(id);
      allow update: if false;
      allow delete: if false;
    }

    match /householdActivities/{id} {
      allow read: if isStaffActive();
      allow create, update: if isManagerOrStaff();
      allow delete: if isManagerOrStaff();
    }
    function isValidAttachmentVersionCreate(versionId) {
      let previousId = request.resource.data.versionOf;
      let previousPath = /databases/$(database)/documents/attachments/$(previousId);
      let previous = get(previousPath).data;
      let previousAfter = getAfter(previousPath).data;
      let previousNumber = previous.get('versionNumber', 1);
      return isManagerOrAdmin() &&
        previousId is string && previousId.size() > 0 && previousId != versionId &&
        exists(previousPath) && existsAfter(previousPath) &&
        request.resource.data.id == versionId &&
        request.resource.data.versionNumber is int &&
        request.resource.data.versionNumber == previousNumber + 1 &&
        request.resource.data.uploadedBy.uid == request.auth.uid &&
        request.resource.data.targetType == previous.targetType &&
        request.resource.data.targetId == previous.targetId &&
        request.resource.data.category == previous.category &&
        (!request.resource.data.keys().hasAny(['versionNote']) ||
          (request.resource.data.versionNote is string && request.resource.data.versionNote.size() <= 500)) &&
        !previous.keys().hasAny(['supersededBy']) &&
        previousAfter.supersededBy == versionId &&
        previousAfter.versionNumber == previousNumber &&
        previousAfter.diff(previous).affectedKeys().hasOnly(['supersededBy', 'updatedAt', 'versionNumber']) &&
        (previous.targetType != 'safeguardingCase' || canWriteSafeguardingAttachment(previous.targetId));
    }

    function isValidAttachmentSupersede(id) {
      let versionId = request.resource.data.supersededBy;
      let versionPath = /databases/$(database)/documents/attachments/$(versionId);
      let versionAfter = getAfter(versionPath).data;
      let previousNumber = resource.data.get('versionNumber', 1);
      return isManagerOrAdmin() &&
        versionId is string && versionId.size() > 0 &&
        existsAfter(versionPath) &&
        request.resource.data.versionNumber == previousNumber &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['supersededBy', 'updatedAt', 'versionNumber']) &&
        versionAfter.versionOf == id &&
        versionAfter.versionNumber == previousNumber + 1 &&
        versionAfter.targetType == resource.data.targetType &&
        versionAfter.targetId == resource.data.targetId &&
        versionAfter.uploadedBy.uid == request.auth.uid &&
        (resource.data.targetType != 'safeguardingCase' || canWriteSafeguardingAttachment(resource.data.targetId));
    }

    match /attachments/{id} {
      allow read: if isStaffActive() && (
        (resource.data.targetType != 'safeguardingCase' || canReadSafeguarding(resource.data.targetId)) &&
        ((resource.data.targetType != 'healthFollowUp' &&
          !(resource.data.get('category', '') in ['Medical Document', 'Prescription'])) || canViewHealthRecords())
      );
      allow create: if request.resource.data.keys().hasAny(['versionOf'])
        ? isValidAttachmentVersionCreate(id)
        : (request.resource.data.targetType == 'safeguardingCase'
          ? canWriteSafeguardingAttachment(request.resource.data.targetId)
          : (request.resource.data.targetType == 'healthFollowUp' ||
             request.resource.data.get('category', '') in ['Medical Document', 'Prescription'])
            ? canEditHealthRecords()
            : isManagerOrStaff());
      allow update: if request.resource.data.diff(resource.data).affectedKeys().hasAny(['supersededBy'])
        ? isValidAttachmentSupersede(id)
        : resource.data.keys().hasAny(['supersededBy'])
          ? false
          : resource.data.keys().hasAny(['versionOf'])
            ? isManagerOrAdmin() &&
              (resource.data.targetType != 'safeguardingCase' || canWriteSafeguardingAttachment(resource.data.targetId)) &&
              ((resource.data.targetType != 'healthFollowUp' &&
                !(resource.data.get('category', '') in ['Medical Document', 'Prescription'])) || canEditHealthRecords()) &&
              request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                'filingMetadata', 'filingAudit', 'filingMetadataUpdatedAt'
              ])
            : (request.resource.data.targetType == 'safeguardingCase'
              ? canWriteSafeguardingAttachment(request.resource.data.targetId)
              : (request.resource.data.targetType == 'healthFollowUp' ||
                 request.resource.data.get('category', '') in ['Medical Document', 'Prescription'])
                ? canEditHealthRecords()
                : isManagerOrAdmin());
      allow delete: if resource.data.keys().hasAny(['versionOf', 'supersededBy'])
        ? false
        : resource.data.targetType == 'safeguardingCase'
          ? canWriteSafeguardingAttachment(resource.data.targetId)
          : (resource.data.targetType == 'healthFollowUp' ||
             resource.data.get('category', '') in ['Medical Document', 'Prescription'])
            ? canEditHealthRecords()
            : isAdmin() || (isManagerOrStaff() && resource.data.uploadedBy.uid == request.auth.uid);
    }

    match /caseActions/{actionId} {
      // Single-record reads retain the legacy missing-sourceType default.
      allow get: if (resource.data.get('sourceType', '') != 'healthFollowUp' || canViewHealthRecords()) &&
        (resource.data.get('sourceType', '') != 'safeguarding' || canViewSafeguardingRecords()) &&
        (isManagerOrAdmin() ||
          (isStaffActive() && resource.data.assignedStaffId == request.auth.uid));
      // Use direct field access for list queries so Firestore can prove that a
      // query excludes restricted action types. The app's not-in / != listeners
      // already exclude legacy records that lack sourceType.
      allow list: if (resource.data.sourceType != 'healthFollowUp' || canViewHealthRecords()) &&
        (resource.data.sourceType != 'safeguarding' || canViewSafeguardingRecords()) &&
        (isManagerOrAdmin() ||
          (isStaffActive() && resource.data.assignedStaffId == request.auth.uid));
      allow create: if (request.resource.data.get('sourceType', '') != 'healthFollowUp' || canViewHealthRecords()) &&
        (request.resource.data.get('sourceType', '') != 'safeguarding' || canViewSafeguardingRecords()) &&
        (isManagerOrAdmin() || (
          isManagerOrStaff() &&
          resource == null &&
          request.resource.data.createdByUid == request.auth.uid &&
          request.resource.data.assignedStaffId == request.auth.uid
        ));
      allow update: if
        (resource.data.get('sourceType', '') != 'healthFollowUp' || canViewHealthRecords()) &&
        (request.resource.data.get('sourceType', '') != 'healthFollowUp' || canViewHealthRecords()) &&
        (resource.data.get('sourceType', '') != 'safeguarding' || canViewSafeguardingRecords()) &&
        (request.resource.data.get('sourceType', '') != 'safeguarding' || canViewSafeguardingRecords()) &&
        (isManagerOrAdmin() || (
          isManagerOrStaff() && resource.data.assignedStaffId == request.auth.uid &&
          request.resource.data.assignedStaffId == resource.data.assignedStaffId &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'status', 'completedAt', 'completionNotes', 'updatedAt', 'updatedBy', 'updatedByUid'
          ])
        ));
      allow delete: if (resource.data.get('sourceType', '') != 'healthFollowUp' || canViewHealthRecords()) &&
        (resource.data.get('sourceType', '') != 'safeguarding' || canViewSafeguardingRecords()) && isAdmin();
    }

    match /caseActionAuditLogs/{eventId} {
      allow get: if (
        (get(/databases/$(database)/documents/caseActions/$(resource.data.recordId)).data.get('sourceType', '') != 'healthFollowUp' || canViewHealthRecords()) &&
        (get(/databases/$(database)/documents/caseActions/$(resource.data.recordId)).data.get('sourceType', '') != 'safeguarding' || canViewSafeguardingRecords())
      ) && (isManagerOrAdmin() || (
        isStaffActive() &&
        get(/databases/$(database)/documents/caseActions/$(resource.data.recordId)).data.assignedStaffId == request.auth.uid
      ));
      // This collection mixes action types and the query cannot constrain the
      // referenced action's sourceType. Restrict listing to roles allowed to
      // inspect safeguarding records; direct get remains action-scoped above.
      allow list: if isManagerOrAdmin() && canViewSafeguardingRecords();
      allow create: if isStaffActive() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if false;
    }

    match /educationHistory/{id} {
      allow read: if isStaffActive();
      allow create, update: if isManagerOrStaff();
      allow delete: if isAdmin();
    }

    match /academicSupports/{id} {
      allow read: if isStaffActive();
      allow create, update: if isManagerOrStaff();
      allow delete: if isAdmin();
    }

    match /examinationRecords/{id} {
      allow read: if isStaffActive();
      allow create, update: if isManagerOrStaff();
      allow delete: if isAdmin();
    }

    match /attendanceRecords/{id} {
      allow read: if isStaffActive();
      allow create, update: if isManagerOrStaff();
      allow delete: if isAdmin();
    }

    match /girlLeaves/{id} {
      allow read: if isStaffActive();
      allow create, update: if isManagerOrStaff();
      allow delete: if isAdmin();
    }

    match /programmeLogs/{id} {
      allow read: if isStaffActive();
      allow create, update: if isManagerOrStaff();
      allow delete: if isAdmin();
    }

    match /caseReviews/{id} {
      allow read: if canViewCaseReviews();
      allow create: if canEditCaseReviews() &&
        (request.resource.data.get('health', '') == '' || canEditHealthRecords());
      allow update: if canEditCaseReviews() &&
        ((resource.data.get('health', '') == '' && request.resource.data.get('health', '') == '') || canEditHealthRecords());
      allow delete: if isAdmin();
    }

    match /caseGoals/{goalId} {
      allow read: if isStaffActive();
      allow create: if isManagerOrStaff() &&
        request.resource.data.createdByUid == request.auth.uid &&
        request.resource.data.updatedByUid == request.auth.uid &&
        request.resource.data.status in ['Not started', 'In progress', 'Achieved', 'Not achieved', 'On hold'] &&
        request.resource.data.title is string && request.resource.data.title.size() > 0 &&
        request.resource.data.targetOutcome is string &&
        request.resource.data.measureOfSuccess is string &&
        (request.resource.data.status in ['Achieved', 'Not achieved']
          ? request.resource.data.get('outcome', '') is string && request.resource.data.get('outcome', '').size() > 0
          : true);
      allow update: if isManagerOrStaff() &&
        request.resource.data.girlId == resource.data.girlId &&
        request.resource.data.id == resource.data.id &&
        request.resource.data.createdByUid == resource.data.createdByUid &&
        request.resource.data.createdAt == resource.data.createdAt &&
        request.resource.data.updatedByUid == request.auth.uid &&
        (request.resource.data.status in ['Achieved', 'Not achieved']
          ? request.resource.data.get('outcome', '') is string && request.resource.data.get('outcome', '').size() > 0
          : true) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'title', 'baseline', 'targetOutcome', 'measureOfSuccess', 'targetDate', 'status',
          'progressNotes', 'outcome', 'outcomeRecordedAt', 'updatedByUid', 'updatedBy', 'updatedAt'
        ]);
      allow delete: if isManagerOrAdmin();
    }

    // Salary and gratuity inputs are restricted to Administrators and Managers.
    // Salary history is append-only so historical remuneration cannot be silently overwritten.
    match /employeeSalaryHistory/{recordId} {
      allow read: if isManagerOrAdmin();
      allow create: if isManagerOrAdmin() &&
        request.resource.data.employeeId != null &&
        request.resource.data.salaryAmount > 0 &&
        request.resource.data.auditMetadata.createdByUid == request.auth.uid;
      allow update, delete: if false;
    }

    match /employeeAuditLogs/{eventId} {
      allow read: if isManagerOrAdmin();
      allow create: if isManagerOrAdmin() && request.resource.data.actorUid == request.auth.uid;
      allow update, delete: if false;
    }

    // Procurement report audit metadata is separate from generic report history,
    // which may archive full report files and has broader staff permissions.
    match /managementProcurementReportHistory/{reportId} {
      allow read: if isManagerOrAdmin() &&
        resource.data.expiresAt is timestamp && resource.data.expiresAt > request.time;
      allow create: if isManagerOrAdmin() &&
        request.resource.data.keys().hasOnly([
          'id', 'reportType', 'generatedByUid', 'generatedAt', 'expiresAt', 'dateBasis',
          'startDate', 'endDate', 'programmeId', 'format', 'selectedListCount', 'aggregateRowCount'
        ]) &&
        request.resource.data.id == reportId &&
        request.resource.data.reportType == 'management-procurement' &&
        request.resource.data.generatedByUid == request.auth.uid &&
        request.resource.data.generatedAt is timestamp &&
        request.resource.data.generatedAt >= request.time - duration.value(5, 'm') &&
        request.resource.data.generatedAt <= request.time + duration.value(5, 'm') &&
        request.resource.data.expiresAt is timestamp &&
        request.resource.data.expiresAt > request.time &&
        request.resource.data.expiresAt >= request.resource.data.generatedAt + duration.value(89, 'd') &&
        request.resource.data.expiresAt <= request.resource.data.generatedAt + duration.value(91, 'd') &&
        request.resource.data.dateBasis in ['createdAt', 'approvedAt', 'orderedAt', 'receivedAt', 'financeHandedOverAt'] &&
        request.resource.data.format in ['docx', 'xlsx', 'csv'] &&
        request.resource.data.selectedListCount is int && request.resource.data.selectedListCount >= 0 &&
        request.resource.data.aggregateRowCount is int && request.resource.data.aggregateRowCount >= 0 &&
        (!request.resource.data.keys().hasAny(['startDate']) ||
          (request.resource.data.startDate is string && request.resource.data.startDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$'))) &&
        (!request.resource.data.keys().hasAny(['endDate']) ||
          (request.resource.data.endDate is string && request.resource.data.endDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$'))) &&
        (!request.resource.data.keys().hasAny(['programmeId']) ||
          request.resource.data.programmeId in [
            'early-years', 'shine-village', 'bursary', 'child-house', 'relief-family',
            'fish-farming', 'chicken-farming', 'fish-chicken', 'rice-maize-mill', 'tomato-farming'
          ]);
      allow update, delete: if false;
    }

    match /reportHistory/{reportId} {
      allow read: if isManagerOrAdmin() || (
        isStaffActive() && resource.data.generatedByUid == request.auth.uid
      );
      allow create: if isManagerOrStaff() &&
        request.resource.data.id == reportId &&
        request.resource.data.generatedByUid == request.auth.uid &&
        request.resource.data.status == 'Generated' &&
        request.resource.data.fileType in ['docx', 'xlsx', 'pdf', 'csv'] &&
        (!('storagePath' in request.resource.data.keys()) ||
          (request.resource.data.storagePath is string &&
           request.resource.data.storagePath.matches('reports/' + request.auth.uid + '/' + reportId + '/.*'))) &&
        request.resource.data.keys().hasOnly([
          'id', 'reportType', 'title', 'reportingPeriod', 'dateRange', 'filters',
          'generatedBy', 'generatedByUid', 'generatedAt', 'fileType', 'fileName', 'storagePath',
          'dataSourceReferences', 'recordCount', 'photoCount', 'tableCount', 'status'
        ]);
      allow update, delete: if false;
    }

    match /reportExports/{exportId} {
      allow read: if isManagerOrAdmin() || (
        isStaffActive() && resource.data.generatedByUid == request.auth.uid
      );
      allow create: if isManagerOrStaff() &&
        request.resource.data.id == exportId &&
        request.resource.data.generatedByUid == request.auth.uid &&
        request.resource.data.hash is string &&
        request.resource.data.format in ['docx', 'pdf', 'marked-docx', 'xlsx', 'csv'] &&
        request.resource.data.finalLocked is bool &&
        request.resource.data.keys().hasOnly([
          'id', 'reportType', 'title', 'fileName', 'format', 'version', 'hash',
          'openProblems', 'overrides', 'generatedBy', 'generatedByUid',
          'generatedAt', 'draft', 'finalLocked'
        ]);
      allow update, delete: if false;
    }

    // Sensitive records and their access audit are server-only; Admin SDK endpoints enforce grants and log reads.
    match /safeguardingCases/{caseId} {
      allow read, write: if false;
    }

    match /safeguardingAuditLogs/{eventId} {
      allow read, write: if false;
    }

    match /aiAuditLogs/{id} {
      allow read: if isAdmin();
      // Audit records are written by the trusted server using the Admin SDK.
      allow create, update, delete: if false;
    }

    // Budgets - Financial planning and allocations
    match /budgets/{id} {
      allow read: if isStaffActive();
      allow create, update: if isManagerOrStaff();
      allow delete: if isAdmin();
    }

    match /annualBudgets/{id} {
      allow read: if isManagerOrAdmin() || isStaffActive();
      allow create, update: if isManagerOrAdmin();
      allow delete: if isAdmin();
    }

    match /payrollRecords/{id} {
      allow read: if isManagerOrAdmin() || (
        isManagerOrStaff() && resource.data.staffUid == request.auth.uid
      );
      allow create: if isManagerOrAdmin() &&
        request.resource.data.employeeId != null &&
        request.resource.data.expectedAmount >= 0 &&
        request.resource.data.createdByUid == request.auth.uid;
      allow update: if isManagerOrAdmin() && request.resource.data.updatedByUid == request.auth.uid;
      allow delete: if isAdmin();
    }

    match /employees/{id} {
      allow read: if isManagerOrAdmin();
      allow create: if isManagerOrAdmin() &&
        request.resource.data.id == id &&
        request.resource.data.createdBy == getStaffDoc(request.auth.uid).data.fullName;
      allow update: if isManagerOrAdmin() &&
        request.resource.data.id == resource.data.id;
      allow delete: if isAdmin();
    }

    // Workplans - Strategic and operational work planning
    match /workplans/{id} {
      allow read: if isStaffActive();
      allow create, update: if isManagerOrStaff();
      allow delete: if isAdmin();
    }

    match /procurementLists/{id} {
      allow read: if isInventoryActiveStaff();
      allow create: if isInventoryWriter() &&
        request.resource.data.status == 'draft' &&
        !request.resource.data.keys().hasAny([
          'approvedAt', 'approvedBy', 'purchaseOrderReference', 'orderedAt', 'orderedBy',
          'receivedAt', 'receivedBy', 'financeHandedOverAt', 'financeHandedOverBy', 'financeReference'
        ]);
      allow update: if isInventoryWriter() &&
        (resource.data.status == 'draft' || isManagerOrAdmin() ||
          (request.resource.data.status == resource.data.status &&
           request.resource.data.diff(resource.data).affectedKeys().hasOnly(['receivedAt', 'receivedBy', 'updatedAt', 'updatedBy'])) ||
          isValidProcurementReceiptLedgerUpdate(id)) &&
        (request.resource.data.status == resource.data.status ||
          (isManagerOrAdmin() && (
            (resource.data.status == 'draft' && request.resource.data.status == 'approved' &&
             request.resource.data.items.size() > 0 && request.resource.data.approvedAt is string && request.resource.data.approvedBy is string) ||
            (resource.data.status == 'approved' && request.resource.data.status == 'purchased' &&
             request.resource.data.purchaseOrderReference is string && request.resource.data.purchaseOrderReference.size() > 0 &&
             request.resource.data.orderedAt is string && request.resource.data.orderedBy is string)
          ))) &&
        (!request.resource.data.diff(resource.data).affectedKeys().hasAny([
          'approvedAt', 'approvedBy', 'purchaseOrderReference', 'orderedAt', 'orderedBy',
          'financeHandedOverAt', 'financeHandedOverBy', 'financeReference'
        ]) || isManagerOrAdmin()) &&
        (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['receivedAt', 'receivedBy']) ||
          resource.data.status == 'purchased') &&
        (!request.resource.data.diff(resource.data).affectedKeys().hasAny([
          'financeHandedOverAt', 'financeHandedOverBy', 'financeReference'
        ]) || (resource.data.status == 'purchased' && resource.data.receivedAt is string &&
          request.resource.data.financeHandedOverAt is string &&
          request.resource.data.financeReference is string && request.resource.data.financeReference.size() > 0));
      allow delete: if isAdmin();
    }

    // Managed inventory locations are readable by active staff. The normalized
    // name is the deterministic ID suffix, preventing case/spacing duplicates.
    match /inventoryLocations/{locationId} {
      allow read: if isStaffActive();
      allow create: if isManagerOrAdmin() &&
        request.resource.data.id == locationId &&
        request.resource.data.name is string &&
        request.resource.data.name.size() > 0 &&
        request.resource.data.name.size() <= 80 &&
        request.resource.data.name.matches('^[^/]+$') &&
        request.resource.data.normalizedName == request.resource.data.name.lower() &&
        locationId == 'loc_' + request.resource.data.normalizedName &&
        request.resource.data.isActive == true &&
        request.resource.data.createdByUid == request.auth.uid &&
        request.resource.data.updatedByUid == request.auth.uid;
      allow update, delete: if false;
    }

    match /inventoryLocationBalances/{balanceId} {
      allow read: if isInventoryActiveStaff();
      allow create: if isValidInventoryLocationBalanceCreate(balanceId);
      allow update: if isValidInventoryLocationBalanceUpdate(balanceId);
      allow delete: if false;
    }

    match /inventoryItems/{id} {
      allow read: if isInventoryActiveStaff();
      allow create: if isInventoryWriter() &&
        request.resource.data.quantityOnHand == 0 &&
        request.resource.data.locationId is string &&
        exists(/databases/$(database)/documents/inventoryLocations/$(request.resource.data.locationId)) &&
        get(/databases/$(database)/documents/inventoryLocations/$(request.resource.data.locationId)).data.isActive == true &&
        get(/databases/$(database)/documents/inventoryLocations/$(request.resource.data.locationId)).data.name == request.resource.data.location &&
        isInventoryQuantityPrecisionValid(request.resource.data.unit, request.resource.data.minimumStockLevel) &&
        request.resource.data.movements is list &&
        request.resource.data.movements.size() == 0;
      allow update: if isInventoryWriter() &&
        // Until the location ledger and transfer workflow are live, the legacy
        // single-location field is immutable at the database boundary.
        request.resource.data.location == resource.data.location &&
        request.resource.data.get('locationId', '') == resource.data.get('locationId', '') &&
        isInventoryQuantityPrecisionValid(request.resource.data.unit, request.resource.data.minimumStockLevel) &&
        (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['unit']) ||
          (resource.data.quantityOnHand == 0 && resource.data.get('movements', []).size() == 0)) &&
        (
          !request.resource.data.diff(resource.data).affectedKeys().hasAny([
            'quantityOnHand', 'movements', 'lastMovementId'
          ]) ||
          isValidInventoryMovementUpdate(id)
        );
      allow delete: if isAdmin();
    }

    match /inventoryMovements/{movementId} {
      allow read: if isInventoryActiveStaff();
      allow create: if isValidInventoryMovementCreate(movementId);
      allow update, delete: if false;
    }

    match /assets/{id} {
      allow read: if isStaffActive();
      allow create, update: if isManagerOrStaff();
      allow delete: if isAdmin();
    }

    match /projectProjections/{id} {
      allow read: if isManagerOrAdmin();
      allow create, update: if isManagerOrAdmin();
      allow delete: if isAdmin();
    }

    // Schedules - Field activity and visit timelines
    function isValidTripRequestCreate() {
      return request.resource.data.type != 'transport_trip' || (
        request.resource.data.tripApprovalStatus == 'Pending' &&
        request.resource.data.status == 'Scheduled' &&
        request.resource.data.tripRequestedByUid == request.auth.uid &&
        request.resource.data.assignedStaffId == request.auth.uid &&
        !request.resource.data.keys().hasAny(['tripApprovedByUid', 'tripApprovedAt'])
      );
    }

    function isValidTripApprovalUpdate() {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      return isManagerOrAdmin() && resource.data.type == 'transport_trip' &&
        resource.data.tripApprovalStatus == 'Pending' &&
        request.resource.data.tripApprovalStatus in ['Approved', 'Rejected'] &&
        request.resource.data.tripApprovedByUid == request.auth.uid &&
        request.resource.data.tripApprovedAt is string &&
        changed.hasOnly(['tripApprovalStatus', 'tripApprovedByUid', 'tripApprovedByName', 'tripApprovedAt', 'tripApprovalNote', 'status', 'updatedAt', 'updatedBy']) &&
        (request.resource.data.tripApprovalStatus != 'Approved' || request.resource.data.status == 'Scheduled') &&
        (request.resource.data.tripApprovalStatus != 'Rejected' || request.resource.data.status == 'Cancelled');
    }

    function isValidTripStartUpdate() {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      return resource.data.type == 'transport_trip' &&
        request.resource.data.type == 'transport_trip' &&
        resource.data.tripApprovalStatus == 'Approved' &&
        request.resource.data.tripApprovalStatus == 'Approved' &&
        (isManagerOrAdmin() || (isStaffActive() && resource.data.assignedStaffId == request.auth.uid)) &&
        resource.data.status == 'Scheduled' &&
        request.resource.data.status == 'In Progress' &&
        changed.hasOnly(['status', 'updatedAt', 'updatedBy']) &&
        request.resource.data.get('transportDetails', {}) == resource.data.get('transportDetails', {});
    }

    function isValidTripCompletionUpdate() {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      return resource.data.type == 'transport_trip' &&
        request.resource.data.type == 'transport_trip' &&
        resource.data.tripApprovalStatus == 'Approved' &&
        request.resource.data.tripApprovalStatus == 'Approved' &&
        (isManagerOrAdmin() || (isStaffActive() && resource.data.assignedStaffId == request.auth.uid)) &&
        changed.hasOnly(['status', 'completedAt', 'transportDetails', 'updatedAt', 'updatedBy']) &&
        resource.data.status == 'In Progress' &&
        request.resource.data.status == 'Completed' &&
        request.resource.data.get('completedAt', null) is string &&
        request.resource.data.get('transportDetails', {}) is map &&
        resource.data.get('transportDetails', {}) is map &&
        request.resource.data.get('transportDetails', {}).diff(resource.data.get('transportDetails', {})).affectedKeys().hasOnly(['endOdometerKm']) &&
        request.resource.data.get('transportDetails', {}).get('endOdometerKm', null) is number &&
        request.resource.data.get('transportDetails', {}).get('endOdometerKm', 0) >= resource.data.get('transportDetails', {}).get('startOdometerKm', 0);
    }

    match /schedules/{id} {
      allow read: if isStaffActive();
      allow create: if isManagerOrStaff() && isValidTripRequestCreate();
      allow update: if request.resource.data.diff(resource.data).affectedKeys().hasAny([
        'tripApprovalStatus', 'tripApprovedByUid', 'tripApprovedByName', 'tripApprovedAt', 'tripApprovalNote'
      ]) ? isValidTripApprovalUpdate() : (resource.data.type == 'transport_trip' || request.resource.data.type == 'transport_trip')
        ? (resource.data.status == 'Scheduled' && request.resource.data.status == 'In Progress'
          ? isValidTripStartUpdate()
          : isValidTripCompletionUpdate())
        : isManagerOrStaff();
      allow delete: if resource.data.type == 'transport_trip' ? isManagerOrAdmin() : isManagerOrStaff();
    }

    match /meetings/{id} {
      allow read: if isStaffActive();
      allow create, update: if isManagerOrStaff();
      allow delete: if isManagerOrAdmin();
    }

    match /feedingProgramLogs/{id} {
      allow read: if isStaffActive();
      allow create, update: if isManagerOrStaff();
      allow delete: if isManagerOrStaff();
    }

    match /marketPrices/{id} {
      allow read: if isStaffActive();
      allow create, update: if isManagerOrStaff();
      allow delete: if isManagerOrAdmin();
    }

    match /forecastSettings/{id} {
      allow read: if isStaffActive();
      allow create, update: if isManagerOrAdmin();
      allow delete: if isAdmin();
    }

    match /whatIfScenarios/{id} {
      allow read: if isManagerOrAdmin();
      allow create: if isManagerOrAdmin();
      allow update, delete: if isAdmin();
    }

    match /intelligenceSuggestions/{id} {
      allow read: if isStaffActive();
      allow create: if isManagerOrStaff() && request.resource.data.createdBy == 'SHINE Intelligence';
      allow update: if isStaffActive() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reviewStatus', 'suggestedAction', 'suggestedDueDate', 'assignedStaffId', 'reviewedByUid', 'reviewedAt']);
      allow delete: if isManagerOrAdmin();
    }

    match /aiSettings/{id} {
      allow read: if isStaffActive();
      allow create, update: if isAdmin();
      allow delete: if isAdmin();
    }

    // Historical Case Records - Non-overwriting historical documents archive
    match /historicalCaseRecords/{id} {
      allow read: if isStaffActive() && (resource.data.recordType != 'medical' || canViewHealthRecords());
      allow create, update: if isManagerOrStaff();
      allow delete: if isAdmin();
    }

    // Import audit metadata is staff-readable; original source rows belong only in
    // restrictedImportSources. Legacy audit docs containing sourceData stay hidden from
    // ordinary staff until the repair migration removes that field. Ordinary collection
    // queries remain disabled until the Admin-SDK migration verifies the full collection.
    match /importAudits/{id} {
      allow get: if isStaffActive() &&
        (!exists(/databases/$(database)/documents/importAudits/$(id)) ||
          !resource.data.keys().hasAny(['sourceData']) || isManagerOrAdmin());
      allow list: if isManagerOrAdmin() || (isStaffActive() && importAuditMigrationComplete());
      allow create: if isManagerOrStaff() &&
        !request.resource.data.keys().hasAny(['sourceData']) &&
        (!request.resource.data.keys().hasAny(['sourceDataStoredInRestrictedCollection']) ||
          request.resource.data.sourceDataStoredInRestrictedCollection == false ||
          (request.resource.data.sourceDataStoredInRestrictedCollection == true &&
            hasMatchingRestrictedImportSource(id, request.resource.data)));
      allow update: if isAdmin() &&
        !request.resource.data.keys().hasAny(['sourceData']);
      allow delete: if isAdmin();
    }

    match /importAuditMigrationStatus/{id} {
      allow read, write: if false;
    }

    match /restrictedImportSources/{id} {
      allow read: if isManagerOrAdmin();
      allow create: if isManagerOrStaff();
      allow update: if isManagerOrAdmin();
      allow delete: if isAdmin();
    }

    // Early Years Programme - Pre-school and ECD programme monitoring
    match /earlyYearsRecords/{id} {
      allow read: if isStaffActive();
      allow create, update: if isManagerOrStaff();
      allow delete: if isAdmin();
    }

    // People directory is separate from staff login accounts.
    match /people/{personId} {
      allow read: if isStaffActive();
      allow create, update: if isManagerOrStaff();
      allow delete: if isAdmin();
    }

    // Contacts contain staff-managed personal data; never expose them publicly or hard-delete them.
    match /contacts/{contactId} {
      allow read: if isStaffActive();
      allow create: if isManagerOrStaff() &&
        request.resource.data.id == contactId &&
        request.resource.data.type in ['person', 'organisation'] &&
        request.resource.data.name is string &&
        request.resource.data.createdBy == request.auth.uid &&
        request.resource.data.createdByUid == request.auth.uid &&
        request.resource.data.updatedByUid == request.auth.uid &&
        request.resource.data.updatedByName is string &&
        request.resource.data.archived == false &&
        request.resource.data.keys().hasOnly([
          'id', 'type', 'name', 'aliases', 'organisationId', 'affiliation',
          'roleTitle', 'category', 'phone', 'email', 'address', 'district',
          'notes', 'programmes', 'firstSeen', 'lastSeen', 'createdBy',
          'createdByUid', 'createdAt', 'updatedAt', 'updatedByUid',
          'updatedByName', 'source', 'archived', 'interactions', 'mergedInto'
        ]);
      allow update: if isManagerOrStaff() &&
        request.resource.data.createdByUid == resource.data.createdByUid &&
        request.resource.data.updatedByUid == request.auth.uid &&
        request.resource.data.updatedByName is string &&
        request.resource.data.archived is bool &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'name', 'type', 'aliases', 'organisationId', 'affiliation', 'roleTitle',
          'category', 'phone', 'email', 'address', 'district', 'notes', 'programmes',
          'firstSeen', 'lastSeen', 'updatedAt', 'updatedByUid', 'updatedByName',
          'source', 'archived', 'interactions', 'mergedInto'
        ]);
      allow delete: if false;

      match /interactions/{interactionId} {
        allow read: if isStaffActive();
        allow create: if isManagerOrStaff() &&
          request.resource.data.createdByUid == request.auth.uid;
        allow update, delete: if false;
      }
    }

    // Staff Conversations
    match /staffConversations/{convId} {
      allow read: if isStaffActive() && (
        request.auth.uid in resource.data.participants ||
        isAdmin()
      );
      allow create: if isStaffActive() &&
        request.auth.uid in request.resource.data.participants &&
        request.resource.data.createdBy == request.auth.uid;
      allow update: if isStaffActive() && (
        request.auth.uid in resource.data.participants ||
        isAdmin()
      ) && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
        'lastMessageText', 'lastMessageAt', 'lastMessageSenderId',
        'lastMessageSenderName', 'unreadCounts', 'archivedBy', 'updatedAt'
      ]);
      allow delete: if isAdmin() || (isStaffActive() && request.auth.uid in resource.data.participants);
    }

    // Staff Messages - strictly prevents impersonation
    match /staffMessages/{msgId} {
      allow read: if isStaffActive() && (
        request.auth.uid in resource.data.recipientUids ||
        resource.data.senderId == request.auth.uid ||
        isAdmin()
      );
      allow create: if isStaffActive() &&
        request.resource.data.senderId == request.auth.uid &&
        request.auth.uid in request.resource.data.recipientUids &&
        exists(/databases/$(database)/documents/staffConversations/$(request.resource.data.conversationId)) &&
        request.auth.uid in get(/databases/$(database)/documents/staffConversations/$(request.resource.data.conversationId)).data.participants &&
        request.resource.data.recipientUids.hasOnly(
          get(/databases/$(database)/documents/staffConversations/$(request.resource.data.conversationId)).data.participants
        );
      allow update: if isStaffActive() && (
        request.auth.uid in resource.data.recipientUids ||
        resource.data.senderId == request.auth.uid
      ) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'readBy', 'readAt']);
      allow delete: if isAdmin() || (isStaffActive() && resource.data.senderId == request.auth.uid);
    }

    // Staff Notifications - private to target recipient
    match /staffNotifications/{notifId} {
      allow read: if isStaffActive() && resource.data.userId == request.auth.uid;
      allow create: if isStaffActive();
      allow update: if isStaffActive() && resource.data.userId == request.auth.uid;
      allow delete: if isStaffActive() && (resource.data.userId == request.auth.uid || isAdmin());
    }

    // Staff Announcements - org-wide broadcasts strictly restricted to Admins
    match /staffAnnouncements/{annId} {
      allow read: if isStaffActive();
      allow create: if isAdmin();
      allow update: if isAdmin() || (isStaffActive() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['readBy']));
      allow delete: if isAdmin();
    }

    // User Notification Preferences
    match /userNotificationPreferences/{userId} {
      allow read: if isStaffActive() && (request.auth.uid == userId || isAdmin());
      allow create, update: if isStaffActive() && (request.auth.uid == userId || isAdmin());
      allow delete: if isAdmin() || (isStaffActive() && request.auth.uid == userId);
    }
  }
}
