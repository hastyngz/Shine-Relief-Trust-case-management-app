{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "dev:r2-worker": "wrangler dev --config workers/r2-storage/wrangler.toml",
    "deploy:r2-worker": "wrangler deploy --config workers/r2-storage/wrangler.toml",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "start": "node dist/server.cjs",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "audit:firestore-access": "node scripts/audit-firestore-access.mjs",
    "test:ui-effects": "tsx scripts/ui-effects.test.tsx",
    "test:health-access": "tsx scripts/health-access.test.ts",
    "test:case-goals": "tsx scripts/case-goals-persistence.test.ts",
    "test:quality": "tsx scripts/quality-rules.test.ts && tsx scripts/programme-separation.test.ts && tsx scripts/phase3b-financial.test.ts && tsx scripts/compliance-calendar.test.ts",
    "test:procurement": "tsx scripts/procurement-workflow.test.ts",
    "test:report-writing-help": "tsx scripts/report-writing-help.test.ts",
    "test:early-warning": "tsx scripts/early-warning-service.test.ts",
    "test:payroll": "tsx scripts/payroll-service.test.ts && tsx scripts/gratuity.test.ts",
    "test:firestore-listener-permissions": "tsx scripts/firestore-listener-permissions.test.ts",
    "test:rules": "firebase emulators:exec --only firestore \"tsx scripts/firestore-rules.test.ts\"",
    "test:import-audit-migration": "tsx scripts/import-audit-source-migration.test.ts",
    "test:phase5-rules": "firebase emulators:exec --project demo-shine-phase5-rules --only firestore \"tsx scripts/phase5-rules.test.ts\"",
    "test:phase5": "tsx scripts/phase5-intelligence.test.ts && tsx scripts/phase5-case-intelligence.test.ts",
    "test:phase5-e2e": "tsx scripts/phase5-e2e.test.ts",
    "test:phase2": "tsx scripts/phase2-import-ai.test.ts",
    "test:offline": "tsx scripts/offline-sync.test.ts",
    "test:offline-perf": "tsx scripts/offline-sync-perf.test.ts",
    "test:storage": "tsx scripts/storage-failures.test.ts && tsx scripts/firestore-reset-policy.test.ts && tsx scripts/backup-restore-coverage.test.ts",
    "test:storage-upload-validation": "tsx scripts/storage-upload-validation.test.ts",
    "test:r2-worker-upload-validation": "tsx scripts/r2-worker-upload-validation.test.mjs",
    "test:error-boundary": "tsx scripts/error-boundary.test.tsx",
    "test:code-splitting": "tsx scripts/code-splitting.test.ts",
    "test:app-shell": "tsx scripts/app-shell-offline.test.ts",
    "test:rate-limit": "tsx scripts/rate-limit.test.ts",
    "test:routing": "tsx scripts/routing.test.ts",
    "test:deployment-smoke": "tsx scripts/cloudflare-deployment-smoke.test.ts",
    "test:offline-queue": "tsx scripts/offline-queue-idb.test.ts",
    "test:e2e": "playwright test",
    "test:inventory": "tsx scripts/inventory.test.ts && tsx scripts/inventory-integrity-audit.test.ts",
    "audit:inventory-snapshot": "tsx scripts/audit-inventory-snapshot.ts",
    "test:asset-export": "tsx scripts/asset-export.test.ts",
    "test:asset-verification": "tsx scripts/asset-verification.test.ts",
    "test:compliance": "tsx scripts/compliance-calendar.test.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.850.0",
    "@aws-sdk/s3-request-presigner": "^3.850.0",
    "@google-cloud/firestore": "^9.2.0",
    "@google-cloud/storage": "^8.2.0",
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.1.1",
    "docx": "^9.7.1",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "firebase": "^12.19.0",
    "firebase-admin": "^14.5.0",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.8",
    "jszip": "^3.10.2",
    "lucide-react": "^0.546.0",
    "mammoth": "^1.12.3",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "vite": "^8.3.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.2",
    "@playwright/test": "^1.64.1",
    "@types/express": "^4.17.21",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.28.0",
    "fake-indexeddb": "^6.2.5",
    "firebase-tools": "^15.31.0",
    "jsdom": "^30.1.1",
    "playwright": "^1.64.1",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2",
    "wrangler": "^4.151.0"
  }
}
